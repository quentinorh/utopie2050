<% content_for :title, "SP2050 - Créer un compte" %>
<% content_for :description, "Rejoignez la communauté SP2050. Créez votre compte pour partager vos visions d'un futur désirable et durable." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :hide_navbar, true %>

<% unique_id = "signup-#{SecureRandom.hex(4)}" %>

<div class="sp-auth sp-auth--wizard"
     data-controller="cover-editor editor-reveal signup"
     data-cover-editor-unique-id-value="<%= unique_id %>"
     data-cover-editor-new-record-value="true">

  <!-- Colonne gauche : couverture aléatoire + barre du générateur -->
  <%= render "devise/cover_stage", unique_id: unique_id %>

  <!-- Colonne droite : assistant d'inscription -->
  <div class="sp-panel">
    <div class="sp-content">
      <div class="sp-head">
        <h1 class="sp-title editor-stagger">Bienvenue</h1>
        <p class="sp-subtitle editor-stagger">Pour t'inscrire, quelques questions avec le toi du futur.</p>
      </div>

      <%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), method: :post, class: "sp-form" do |f| %>
        <%# Honeypot anti-bot %>
        <div aria-hidden="true" style="position:absolute; left:-9999px; top:-9999px; height:0; width:0; overflow:hidden;">
          <label for="user_website_url">Ne pas remplir</label>
          <input type="text" name="user[website_url]" id="user_website_url" tabindex="-1" autocomplete="off" />
        </div>

        <%# Scène : seule la question courante y est visible ; les étapes se
            fondent horizontalement. La barre de nav ci-dessous ne bouge jamais. %>
        <div class="sp-stage editor-stagger" data-signup-target="stage">
          <!-- Étape 1 — Pseudo -->
          <div class="sp-step" data-signup-target="step" data-step="username">
            <div class="sp-field">
              <%= f.label :username, "En 2050, comment aimerais-tu être appelé·e ?", class: "sp-label" %>
              <%= f.text_field :username,
                               autofocus: true,
                               autocomplete: "off",
                               placeholder: "Je m'appelle …",
                               class: "sp-input",
                               data: { signup_target: "username", action: "input->signup#clearFieldError" } %>
              <p class="sp-error" data-signup-target="error"></p>
            </div>
          </div>

          <!-- Étape 2 — Âge -->
          <div class="sp-step" data-signup-target="step" data-step="age">
            <div class="sp-field">
              <div class="sp-field__head">
                <%= f.label :age, "Quel âge auras-tu en 2050 ?", class: "sp-label" %>
                <span class="sp-helper">Ça permet de se projeter dans le futur.</span>
              </div>
              <%= f.text_field :age,
                               inputmode: "numeric",
                               autocomplete: "off",
                               placeholder: "Mon âge en 2050",
                               class: "sp-input",
                               data: { signup_target: "age", action: "input->signup#clearFieldError" } %>
              <p class="sp-error" data-signup-target="error"></p>
            </div>
          </div>

          <!-- Étape 3 — Email -->
          <div class="sp-step" data-signup-target="step" data-step="email">
            <div class="sp-field">
              <div class="sp-field__head">
                <%= f.label :email, "Ton adresse email", class: "sp-label" %>
                <span class="sp-helper">On t'enverra un lien magique pour activer ton compte.</span>
              </div>
              <%= f.email_field :email,
                                autocomplete: "email",
                                placeholder: "hello@fromfuture.com",
                                class: "sp-input",
                                data: { signup_target: "email", action: "input->signup#clearFieldError" } %>
              <p class="sp-error" data-signup-target="error"></p>
            </div>
          </div>

          <!-- Étape 4 — Charte -->
          <div class="sp-step" data-signup-target="step" data-step="terms">
            <div class="sp-terms">
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Futurs désirables</h3>
                <p class="sp-terms__text">Chaque histoire doit contribuer à imaginer un monde meilleur pour tous·tes. En publiant, tu t'engages à respecter cette ligne directrice.</p>
              </div>
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Contenus respectueux</h3>
                <p class="sp-terms__text">En 2050, nous imaginons un monde fait de diversité et de respect. Aucun contenu faisant la promotion de discrimination ne sera toléré.</p>
              </div>
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Droit d'auteur·ice</h3>
                <p class="sp-terms__text">Veille à ne partager que des contenus dont tu es l'auteur·ice ou pour lesquels tu as obtenu les droits nécessaires.</p>
              </div>
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Licence libre</h3>
                <p class="sp-terms__text">En publiant, tu acceptes la licence <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer" class="sp-terms__link" data-underline-link>Creative Commons BY-NC-SA 4.0</a>.</p>
              </div>
            </div>
          </div>
        </div>

        <%# Barre de nav partagée : position stable, les CTA ne bougent jamais.
            « Retour » garde sa place (visibility) à l'étape 1 → le CTA reste calé
            à droite. Le libellé du CTA et l'action sont pilotés par le contrôleur. %>
        <div class="sp-nav editor-stagger">
          <button type="button"
                  class="sp-back sp-back--hidden"
                  data-underline-link
                  data-signup-target="back"
                  data-action="click->signup#back">Retour</button>
          <button type="button"
                  class="btn-animate-chars btn-animate-chars--primary sp-next"
                  data-signup-target="next"
                  data-action="click->signup#handleCta">
            <div class="btn-animate-chars__bg"></div>
            <span class="btn-animate-chars__text">Suite</span>
          </button>
        </div>
      <% end %>
    </div>

    <%# « J'ai déjà un compte » : ancré à 10vh du bas, centré dans le blanc.
        Fait partie du stagger d'entrée. %>
    <div class="sp-alt-wrap">
      <%= link_to "J'ai déjà un compte", new_user_session_path, class: "sp-alt editor-stagger", data: { underline_link: "" } %>
    </div>
  </div>
</div>
