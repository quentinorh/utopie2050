<% content_for :title, "SP2050 - Modifier ton profil" %>
<% content_for :description, "Personnalise ton profil SP2050. Mets à jour tes informations et préférences pour une meilleure expérience." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :hide_navbar, true %>

<%= render layout: "devise/frame",
           locals: {
             frame_id: "account-#{SecureRandom.hex(4)}",
             frame_class: "sp-auth--account",
             cover_title: current_user.username
           } do %>
  <div class="sp-content">
    <div class="sp-head">
      <h1 class="sp-title editor-stagger">Mon profil</h1>
      <p class="sp-subtitle editor-stagger">Mettre à jour tes informations.</p>
      <p class="sp-note editor-stagger">
        <%= current_user.posts.count %>
        <%= "texte".pluralize(current_user.posts.count) %>
        · ici depuis <%= current_user.created_at.strftime("%m.%Y") %>
      </p>
    </div>

    <%= form_with model: resource, scope: resource_name, url: registration_path(resource_name), method: :put, class: "sp-form sp-form--fields" do |f| %>
      <div class="sp-field editor-stagger">
        <%= f.label :username, "Nom d'auteur·ice", class: "sp-label" %>
        <%= f.text_field :username,
                         autofocus: true,
                         required: true,
                         autocomplete: "off",
                         placeholder: "Ton pseudo",
                         class: "sp-input #{"sp-input--error" if resource.errors[:username].any?}",
                         data: { form_type: "other", auto_fill: "false", lpignore: "true", "1p_ignore": "true" } %>
        <% if resource.errors[:username].any? %>
          <p class="sp-error"><%= resource.errors[:username].to_sentence %></p>
        <% end %>
      </div>

      <div class="sp-field editor-stagger">
        <%= f.label :email, "Ton adresse email", class: "sp-label" %>
        <%= f.email_field :email,
                          required: true,
                          autocomplete: "email",
                          placeholder: "hello@fromfuture.com",
                          class: "sp-input #{"sp-input--error" if resource.errors[:email].any?}" %>
        <% if resource.errors[:email].any? %>
          <p class="sp-error"><%= resource.errors[:email].to_sentence %></p>
        <% end %>
      </div>

      <div class="sp-field editor-stagger">
        <%= f.label :age, "Ton âge en 2050", class: "sp-label" %>
        <%= f.text_field :age,
                         required: true,
                         inputmode: "numeric",
                         autocomplete: "off",
                         placeholder: "Ton âge en 2050",
                         class: "sp-input #{"sp-input--error" if resource.errors[:age].any?}" %>
        <% if resource.errors[:age].any? %>
          <p class="sp-error"><%= resource.errors[:age].to_sentence %></p>
        <% end %>
      </div>

      <div class="sp-cta editor-stagger">
        <%= render "devise/sessions/submit", label: "Enregistrer" %>
      </div>
    <% end %>

    <p class="sp-note editor-stagger">
      Supprimer ton compte retire aussi tes publications et tes favoris. C'est irréversible.
    </p>
    <%= button_to "Supprimer mon compte",
                  registration_path(resource_name),
                  method: :delete,
                  class: "sp-alt sp-alt--danger editor-stagger",
                  form_class: "sp-danger-form",
                  data: { confirm: "Es-tu sûr ? Cette action est irréversible.", turbo_confirm: "Es-tu sûr ? Cette action est irréversible." } %>
  </div>
<% end %>
