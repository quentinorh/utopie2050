<% content_for :title, "SP2050 - Connexion" %>
<% content_for :description, "Connectez-vous à votre compte SP2050 pour partager vos futurs." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :navbar_transparent, true %>

<div class="auth-page"
     data-controller="auth-background auth-session"
     data-auth-session-show-form-value="<%= flash.present? %>">
  <!-- Animated SVG pattern background -->
  <div class="auth-bg" data-auth-background-target="svg"></div>
  <div class="auth-overlay"></div>

  <!-- Form -->
  <div class="auth-form-container">
    <div class="auth-form">
      <%# Mobile (<640px) : choix inscription / connexion avant le formulaire %>
      <div class="auth-form__choice" data-auth-session-target="choice">
        <h2 class="auth-form__title">Bienvenue</h2>
        <p class="auth-form__subtitle">Rejoins la communauté SP2050</p>
        <div class="auth-form__actions">
          <%= link_to "Créer un compte", new_user_registration_path, class: "auth-btn-primary" %>
          <button type="button"
                  class="auth-btn-secondary"
                  data-action="click->auth-session#showLogin">
            Se connecter
          </button>
        </div>
      </div>

      <div data-auth-session-target="loginForm">
      <h2 class="auth-form__title">Se connecter</h2>
      <p class="auth-form__subtitle">On t'envoie un lien magique par email</p>

      <%= simple_form_for(resource, as: resource_name, url: user_magic_links_path) do |f| %>
        <div class="auth-form__fields">
          <%= f.input :email,
                      label: "Adresse e-mail",
                      required: true,
                      autofocus: false,
                      input_html: { autocomplete: "email", class: 'auth-input', placeholder: "ton@email.com" },
                      label_html: { class: "auth-label" } %>
        </div>

        <div class="auth-form__actions">
          <%= f.button :submit, "Recevoir mon lien", class: "auth-btn-primary", data: { form_type: "other" } %>
          <%= link_to "Créer un compte", new_user_registration_path, class: "auth-btn-secondary auth-form__register-link" %>
        </div>
      <% end %>
      </div>
    </div>
  </div>
</div>
