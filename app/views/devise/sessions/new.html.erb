<% content_for :title, "SP2050 - Connexion" %>
<% content_for :description, "Connectez-vous à votre compte SP2050 pour partager vos futurs." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<%# Maquette plein-cadre : pas de navbar globale (cf. layout application). %>
<% content_for :hide_navbar, true %>

<% unique_id = "signin-#{SecureRandom.hex(4)}" %>

<div class="sp-auth sp-auth--signin"
     data-controller="cover-editor editor-reveal"
     data-cover-editor-unique-id-value="<%= unique_id %>"
     data-cover-editor-new-record-value="true">

  <!-- Colonne gauche : couverture aléatoire + barre du générateur -->
  <%= render "devise/cover_stage", unique_id: unique_id %>

  <!-- Colonne droite : contenu de connexion -->
  <div class="sp-panel">
    <div class="sp-content">
      <div class="sp-head">
        <h1 class="sp-title editor-stagger">Connexion</h1>
        <p class="sp-subtitle editor-stagger">Connectes-toi pour retrouver tes textes, nous t'enverrons un lien de connexion.</p>
      </div>

      <%= form_with url: user_magic_links_path, scope: :user, method: :post, class: "sp-form" do |f| %>
        <div class="sp-field editor-stagger">
          <%= f.label :email, "Ton adresse email", class: "sp-label" %>
          <%= f.email_field :email,
                            required: true,
                            autocomplete: "email",
                            placeholder: "hello@fromfuture.com",
                            class: "sp-input" %>
        </div>

        <label class="sp-remember editor-stagger">
          <%= f.check_box :remember_me, class: "sp-checkbox" %>
          <span class="sp-remember-label">Se souvenir de moi</span>
        </label>

        <%# CTA principal (pleine largeur), marge haute 6vw. %>
        <div class="sp-cta editor-stagger">
          <div id="signin-submit">
            <%= render "devise/sessions/submit", label: "Me connecter" %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Lien secondaire : même placement/CTA que sur l'inscription (10vh du bas,
        centré). Fait partie du stagger d'entrée. %>
    <div class="sp-alt-wrap">
      <%= link_to "Créer mon compte", new_user_registration_path, class: "sp-alt editor-stagger", data: { underline_link: "" } %>
    </div>
  </div>
</div>
