<% content_for :title, "SP2050 - Confirmation d'inscription" %>
<% content_for :description, "Confirme ton compte SP2050 pour accéder à toutes les fonctionnalités de la plateforme." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :hide_navbar, true %>

<%= render layout: "devise/frame", locals: { frame_id: "confirm-#{SecureRandom.hex(4)}" } do %>
  <div class="sp-content">
    <div class="sp-head">
      <h1 class="sp-title editor-stagger">Confirmer mon compte</h1>
      <p class="sp-subtitle editor-stagger">On t'envoie un nouveau lien de confirmation.</p>
    </div>

    <%= form_with model: resource, scope: resource_name, url: confirmation_path(resource_name), method: :post, class: "sp-form" do |f| %>
      <% if resource.errors[:confirmation_token].any? %>
        <p class="sp-error sp-error--center editor-stagger"><%= resource.errors[:confirmation_token].to_sentence %></p>
      <% end %>

      <div class="sp-field editor-stagger">
        <%= f.label :email, "Ton adresse email", class: "sp-label" %>
        <%= f.email_field :email,
                          autofocus: true,
                          required: true,
                          autocomplete: "email",
                          placeholder: "hello@fromfuture.com",
                          value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
                          class: "sp-input #{"sp-input--error" if resource.errors[:email].any?}" %>
        <% if resource.errors[:email].any? %>
          <p class="sp-error"><%= resource.errors[:email].to_sentence %></p>
        <% end %>
      </div>

      <div class="sp-cta editor-stagger">
        <%= render "devise/sessions/submit", label: "Renvoyer le lien" %>
      </div>
    <% end %>
  </div>

  <div class="sp-alt-wrap sp-alt-wrap--row">
    <%= render "devise/shared/links" %>
  </div>
<% end %>
