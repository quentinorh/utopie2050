<div class="auth-form__footer">
  <%- if controller_name != 'sessions' && controller_name != 'magic_links' %>
    <%= link_to "Se connecter", new_session_path(resource_name), class: "auth-link" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Créer un compte", new_registration_path(resource_name), class: "auth-link" %>
  <% end %>
</div>
