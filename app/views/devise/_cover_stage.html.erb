<%# Couverture partagée (connexion, inscription, futur en attente).
    Rend le moteur de couverture (SVG + cibles cover-editor) + la barre du générateur.
    Par défaut le bloc titre est masqué (couverture décorative). Passer `show_title: true`
    avec `title` et `pattern_settings` pour afficher la couverture d'un texte.
    Requiert `unique_id` unique par page. %>
<% title = local_assigns.fetch(:title, "").to_s %>
<% pattern_settings = local_assigns.fetch(:pattern_settings, "").to_s %>
<% show_title = local_assigns.fetch(:show_title, false) %>
<div class="sp-cover" data-controller="mobile-keyboard">
  <%# Logo — retour à l'accueil (la navbar est masquée sur ces pages). %>
  <%= link_to "SP2050", root_path, class: "sp-logo", "aria-label": "Retour à l'accueil" %>

  <button type="button" class="sp-cover-reopen"
          data-action="click->mobile-keyboard#reopenCover"
          aria-label="Afficher la couverture">
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="3" y="1.5" width="10" height="13" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
      <path d="M5.5 5h5M5.5 8h5M5.5 11h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  </button>

  <div class="form-cover-svg form-cover-svg--editor">
    <svg class="cover-svg" shape-rendering="auto" viewBox="0 0 250 350" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="gradient1-<%= unique_id %>" cx="50%" cy="50%" r="50%">
          <stop offset="0%"/>
          <stop offset="100%"/>
        </radialGradient>
        <radialGradient id="gradient2-<%= unique_id %>" cx="50%" cy="50%" r="50%">
          <stop offset="0%"/>
          <stop offset="100%"/>
        </radialGradient>
        <radialGradient id="gradient3-<%= unique_id %>" cx="50%" cy="50%" r="50%">
          <stop offset="0%"/>
          <stop offset="100%"/>
        </radialGradient>
      </defs>
      <g data-cover-editor-target="curveGroup"></g>
    </svg>

    <div class="cover-title-block pointer-events-none" <% unless show_title %>aria-hidden="true"<% end %>>
      <div class="cover-username" data-cover-editor-target="userName"></div>
      <div class="cover-title-text" data-cover-editor-target="titleWrapper"><%= title %></div>
    </div>
  </div>

  <%= render "posts/cover_toolbar", unique_id: unique_id %>

  <div class="sr-only">
    <input type="range" data-cover-editor-target="firstSliderControl" data-action="input->cover-editor#updateCurve" class="hidden">
    <input type="range" data-cover-editor-target="secondSliderControl" data-action="input->cover-editor#updateCurve" class="hidden">
    <input type="hidden" data-cover-editor-target="rows" data-action="input->cover-editor#updateCurve">
    <input type="hidden" data-cover-editor-target="columns" data-action="input->cover-editor#updateCurve">
    <input type="hidden" data-cover-editor-target="patternSettings" value="<%= pattern_settings %>">
    <input type="hidden" data-cover-editor-target="cover">
    <input type="hidden" data-cover-editor-target="titleInput" value="<%= title %>">
    <input type="file" data-cover-editor-target="coverImageFile" accept="image/jpeg,image/png" tabindex="-1" aria-hidden="true" class="hidden">
  </div>
</div>
