<% content_for :title, "SP2050 - Écrire le futur" %>
<% content_for :description, "Découvre comment écrire un futur désirable sur SP2050. Quelques étapes pour t'inspirer avant de commencer ton récit." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :hide_navbar, true %>

<% unique_id = "funnel-#{SecureRandom.hex(4)}" %>

<div class="sp-auth sp-auth--wizard sp-auth--funnel"
     data-controller="cover-editor editor-reveal writing-tutorial"
     data-cover-editor-unique-id-value="<%= unique_id %>"
     data-cover-editor-new-record-value="true"
     data-writing-tutorial-signed-in-value="<%= user_signed_in? %>"
     data-writing-tutorial-username-value="<%= user_signed_in? ? current_user.username : '' %>"
     data-writing-tutorial-age-value="<%= user_signed_in? ? current_user.age : '' %>"
     data-writing-tutorial-skip-path-value="<%= @skip_path %>">

  <!-- Colonne gauche : couverture aléatoire + actions du générateur -->
  <%= render "devise/cover_stage", unique_id: unique_id %>

  <!-- Colonne droite : entonnoir d'écriture -->
  <div class="sp-panel">
    <%# Chrome de progression : phrase cryptique scramblée + pastille % croissant. %>
    <div class="funnel-progress" aria-hidden="true">
      <span class="funnel-progress__phrase"
            data-writing-tutorial-target="progressPhrase"
            data-controller="randomize-letter-animation"
            data-randomize-letter-animation-text-value="initialisation du récit">initialisation du récit</span>
      <span class="funnel-progress__pill">
        <svg class="funnel-progress__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="3" y="1.5" width="10" height="13" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
          <path d="M5.5 5h5M5.5 8h5M5.5 11h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span class="funnel-progress__percent" data-writing-tutorial-target="progressPercent">12%</span>
      </span>
    </div>

    <div class="sp-content">
      <div class="sp-stage editor-stagger" data-writing-tutorial-target="stage">

        <!-- Intro -->
        <div class="sp-step funnel-step--intro" data-writing-tutorial-target="step" data-step="intro">
          <h1 class="sp-title">Bienvenue</h1>
          <p class="sp-subtitle funnel-intro__lead">SP2050 est une plateforme collaborative d'écriture de textes. Nous t'avons prévu quelques questions pour t'aider à te lancer dans l'écriture.</p>
        </div>

        <% unless user_signed_in? %>
          <!-- Pseudo -->
          <div class="sp-step" data-writing-tutorial-target="step" data-step="username">
            <h1 class="sp-title">Ton nom en 2050</h1>
            <div class="funnel-field">
              <label class="sp-label" for="funnel-username">En 2050, comment aimerais-tu être appelé·e ?</label>
              <input type="text" id="funnel-username" class="sp-input"
                     placeholder="Je m'appelle …" autocomplete="username"
                     data-writing-tutorial-target="username"
                     data-action="input->writing-tutorial#checkUsername" />
              <p class="sp-error" data-writing-tutorial-target="usernameError"></p>
            </div>
          </div>

          <!-- Âge -->
          <div class="sp-step" data-writing-tutorial-target="step" data-step="age">
            <h1 class="sp-title">Ton âge en 2050</h1>
            <div class="funnel-field">
              <label class="sp-label" for="funnel-age">En 2050, quel âge auras-tu ?</label>
              <input type="text" id="funnel-age" class="sp-input" inputmode="numeric"
                     placeholder="Mon âge en 2050" autocomplete="off"
                     data-writing-tutorial-target="age"
                     data-action="input->writing-tutorial#clearFieldError" />
              <p class="sp-error" data-writing-tutorial-target="ageError"></p>
            </div>
          </div>
        <% end %>

        <!-- Lieu de vie -->
        <div class="sp-step" data-writing-tutorial-target="step" data-step="living-place">
          <h1 class="sp-title">Ton lieu de vie en 2050</h1>
          <div class="funnel-field">
            <div class="sp-field__head">
              <label class="sp-label" for="funnel-living-place">Où vivras-tu en 2050 ?</label>
              <span class="sp-helper">Une ville, un quartier, un territoire.</span>
            </div>
            <input type="text" id="funnel-living-place" class="sp-input"
                   placeholder="Un quartier coopératif au bord de la Loire" autocomplete="off"
                   data-writing-tutorial-target="livingPlace"
                   data-action="input->writing-tutorial#clearFieldError" />
            <p class="sp-error" data-writing-tutorial-target="livingPlaceError"></p>
          </div>
        </div>

        <% unless user_signed_in? %>
          <!-- Conditions d'utilisation -->
          <div class="sp-step" data-writing-tutorial-target="step" data-step="positive">
            <h1 class="sp-title">Conditions d'utilisation</h1>
            <div class="sp-terms funnel-terms">
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Futurs désirables</h3>
                <p class="sp-terms__text">Chaque histoire doit contribuer à imaginer un monde meilleur pour tous·tes. En publiant, tu t'engages à respecter cette ligne directrice.</p>
              </div>
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Contenus respectueux</h3>
                <p class="sp-terms__text">En 2050, nous imaginons un monde fait de diversité et de respect. Aucun contenu faisant la promotion de discrimination ne sera toléré.</p>
              </div>
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Droit d'auteur·ice</h3>
                <p class="sp-terms__text">Veille à ne partager que des contenus dont tu es l'auteur·ice ou pour lesquels tu as obtenu les droits nécessaires.</p>
              </div>
              <div class="sp-terms__item">
                <h3 class="sp-terms__title">Licence libre</h3>
                <p class="sp-terms__text">En publiant, tu acceptes la licence <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer" class="sp-terms__link" data-underline-link>Creative Commons BY-NC-SA 4.0</a>.</p>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Thème (checkboxes délicieuses) -->
        <div class="sp-step" data-writing-tutorial-target="step" data-step="theme">
          <%# <p class="sp-eyebrow">La fabrique à idée</p> %>
          <h1 class="sp-title">Quelques questions pour stimuler l'écriture</h1>
          <p class="sp-subtitle sp-subtitle--q">Quel thème t'inspire ?</p>

          <div class="funnel-chips" role="radiogroup" aria-label="Thèmes de récit">
            <% %w[Géopolitique Technologie Société Loi Environnement Social].each do |theme| %>
              <button type="button" class="funnel-chip"
                      role="radio" aria-checked="false"
                      data-writing-tutorial-target="themeOption"
                      data-writing-tutorial-theme-param="<%= theme %>"
                      data-action="click->writing-tutorial#selectTheme">
                <span class="funnel-chip__box" aria-hidden="true">
                  <svg class="funnel-chip__check" viewBox="0 0 16 16" fill="none">
                    <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="funnel-chip__label"><%= theme %></span>
              </button>
            <% end %>
          </div>
          <p class="sp-error sp-error--center" data-writing-tutorial-target="themeError"></p>
        </div>

        <!-- Générateur d'étincelles -->
        <div class="sp-step" data-writing-tutorial-target="step" data-step="etincelle">
          <%# <p class="sp-eyebrow">La fabrique à idée</p> %>
          <h1 class="sp-title">Générateur d'étincelles</h1>
          <p class="sp-subtitle sp-subtitle--q">Expérimente des idées pour ton futur récit.</p>
          <%= render "shared/jackpot" %>
        </div>

        <!-- Inversion la tendance -->
        <div class="sp-step" data-writing-tutorial-target="step" data-step="inversion">
          <%# <p class="sp-eyebrow">La fabrique à idée</p> %>
          <h1 class="sp-title">Inversion la tendance</h1>
          <p class="sp-subtitle sp-subtitle--q">Choisis une dynamique actuelle pour combattre la tendance.</p>

          <div class="jackpot jackpot--trend" role="group" aria-label="Tendance à inverser">
            <div class="jackpot__reel jackpot__reel--trend" aria-live="polite">
              <div class="jackpot__strip" data-writing-tutorial-target="trendStrip"></div>
            </div>
            <button type="button" class="jackpot__spin" data-writing-tutorial-target="trendSpin"
                    data-action="click->writing-tutorial#spinTrend" aria-label="Tirer une tendance">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 1.5l1.9 5.9a3 3 0 0 0 1.9 1.9l5.9 1.9-5.9 1.9a3 3 0 0 0-1.9 1.9L12 21l-1.9-5.9a3 3 0 0 0-1.9-1.9L2.3 11.3l5.9-1.9a3 3 0 0 0 1.9-1.9L12 1.5z"/>
              </svg>
            </button>
          </div>
          <p class="sp-error sp-error--center" data-writing-tutorial-target="trendError"></p>

          <div class="funnel-trend__panel" data-writing-tutorial-target="trendOppositePanel" hidden>
            <label class="sp-label funnel-trend__label" for="funnel-trend-opposite">Racontes nous comment on inverse ça</label>
            <textarea id="funnel-trend-opposite" class="sp-input funnel-textarea" rows="3"
                      placeholder="une action, un lieu, un personnage, tout ce qui te viens par la tête."
                      data-writing-tutorial-target="trendOpposite"
                      data-action="input->writing-tutorial#updateTrendOpposite"></textarea>
            <p class="sp-error" data-writing-tutorial-target="trendOppositeError"></p>
          </div>
        </div>

        <!-- Style (checkboxes classiques) -->
        <div class="sp-step" data-writing-tutorial-target="step" data-step="style">
          <%# <p class="sp-eyebrow">La fabrique à idée</p> %>
          <h1 class="sp-title">Choisis un style d'écriture</h1>
          <p class="sp-subtitle sp-subtitle--q">Parmi ces formats, lequel te parle le plus ?</p>

          <div class="funnel-styles" role="radiogroup" aria-label="Styles de récit" data-lenis-prevent>
            <% @narrative_styles.each do |style| %>
              <button type="button" class="funnel-style"
                      role="radio" aria-checked="false"
                      data-writing-tutorial-target="styleOption"
                      data-writing-tutorial-style-id-param="<%= style[:id] %>"
                      data-action="click->writing-tutorial#selectStyle">
                <span class="funnel-style__check" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="funnel-style__title"><%= style[:title] %></span>
                <span class="funnel-style__desc"><%= style[:description] %></span>
              </button>
            <% end %>
          </div>
          <p class="sp-error sp-error--center" data-writing-tutorial-target="styleError"></p>
        </div>

      </div>

      <!-- Barre de nav partagée (stationnaire) -->
      <div class="sp-nav editor-stagger">
        <button type="button" class="sp-back sp-back--hidden" data-underline-link
                data-writing-tutorial-target="back"
                data-action="click->writing-tutorial#back">Retour</button>
        <button type="button" class="btn-animate-chars btn-animate-chars--primary sp-next"
                data-controller="stagger-chars"
                data-writing-tutorial-target="next"
                data-action="click->writing-tutorial#handleCta">
          <div class="btn-animate-chars__bg"></div>
          <span data-button-animate-chars data-stagger-chars-target="text"
                class="btn-animate-chars__text">Commencer</span>
        </button>
      </div>
    </div>

    <%# Passer le didacticiel — va directement à l'éditeur %>
    <div class="sp-alt-wrap funnel-skip-wrap">
      <%= link_to "Passer le guide", @skip_path, class: "sp-alt", data: { underline_link: "", writing_tutorial_target: "skip", action: "click->writing-tutorial#skip" } %>
    </div>
  </div>

  <script type="application/json" id="writing-narrative-styles-json"><%= raw @narrative_styles.to_json %></script>
  <script type="application/json" id="writing-tutorial-trends-json"><%= raw @writing_tutorial_trends.to_json %></script>
</div>
