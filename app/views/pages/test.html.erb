<%# Aperçu de la barre de réglages de couverture, hors session.
    On rend le partial réel (posts/_cover_toolbar) avec le CSS applicatif :
    ce qui s'affiche ici est exactement ce que voit l'éditeur. %>
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <title>Aperçu — Barre de réglages de couverture</title>
    <%= stylesheet_link_tag "tailwind" %>
    <%= stylesheet_link_tag "application", media: "all" %>
    <%= javascript_importmap_tags %>

    <style>
      /* La couverture démarre en haut de page, comme dans l'éditeur : la barre
         de réglages tombe donc bien dans la bande de la navbar. */
      body {
        margin: 0;
        min-height: 100vh;
        background: #08080a;
        font-family: "Apfel", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .preview-note {
        margin: 24px auto;
        max-width: 60ch;
        font-family: "Roboto Mono", monospace;
        font-size: 11px;
        line-height: 1.6;
        letter-spacing: 0.04em;
        color: rgba(250, 250, 250, 0.55);
        text-align: center;
        text-wrap: pretty;
      }

      /* Reproduit le contexte : couverture générée, barre ancrée en bas à droite. */
      .preview-cover {
        position: relative;
        /* Même empilement que .form-left-panel : contexte à z-index 40, donc
           sous la navbar (z-99) — c'est ce qui rendait le clic impossible. */
        z-index: 40;
        width: 100%;
        height: 70vh;
        overflow: hidden;

        /* Même géométrie que .form-left-panel : 50% puis 40% comme l'éditeur. */
        @media (min-width: 1024px) {
          width: 50%;
          height: 100vh;
        }
        @media (min-width: 1440px) {
          width: 40%;
        }
        background-color: #0a0a0c;
        background-image:
          radial-gradient(90% 90% at 18% 12%, hsl(325 92% 62% / 0.9), transparent 62%),
          radial-gradient(70% 70% at 82% 26%, hsl(280 95% 56% / 0.85), transparent 58%),
          radial-gradient(95% 95% at 62% 96%, hsl(225 88% 46% / 0.9), transparent 62%),
          repeating-conic-gradient(from 12deg at 50% 45%, rgba(0, 0, 0, 0.16) 0deg 6deg, rgba(255, 255, 255, 0.05) 6deg 12deg);
      }

      /* .cover-toolbar est en absolute dans le repère de la couverture — même
         rôle que .form-cover-wrapper côté éditeur (borne de recalage des popovers).
         !important : le SCSS applicatif impose une hauteur de viewport sous 1024px. */
      .form-cover-wrapper {
        position: absolute !important;
        inset: 0 !important;
        width: auto !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        background: transparent !important;
      }
    </style>
  </head>

  <body class="form-editor">
    <%# Reproduit la navbar transparente de l'éditeur : elle survole la barre de
        réglages et ne doit pas en intercepter les clics. Sur le vrai éditeur
        (show_post_page) le haut-gauche n'affiche que « SP2050 » ; ici on masque
        le lien « Lire les futurs » du haut-gauche pour rester fidèle. %>
    <style>.navbar-brand + div { display: none; }</style>
    <%= render "shared/navbar", transparent: true %>

    <div class="preview-cover">
      <div class="form-cover-wrapper">
        <%= render "posts/cover_toolbar", unique_id: "preview" %>
      </div>
    </div>

    <div style="max-width: 640px; margin: 32px auto; padding: 0 20px;">
      <div class="editor-title-field editor-stagger" style="opacity: 1;">
        <label for="preview_title" class="sr-only">Titre du futur</label>
        <input type="text" id="preview_title" class="editor-title-input" placeholder="Ton futur titre…">
        <span class="editor-hint" aria-hidden="true">
          <span class="editor-hint__caret"></span>
          <span class="editor-hint__text">Ton futur titre</span>
          <span class="editor-hint__dots"><i>.</i><i>.</i><i>.</i></span>
        </span>
      </div>

      <div class="editor-body-field editor-stagger" style="opacity: 1; margin-top: 28px;">
        <textarea id="preview_body" class="editor-textarea" rows="6" placeholder="Écris ton futur ici…"></textarea>
        <span class="editor-hint" aria-hidden="true">
          <span class="editor-hint__caret"></span>
          <span class="editor-hint__text">Écris ton futur ici</span>
          <span class="editor-hint__dots"><i>.</i><i>.</i><i>.</i></span>
        </span>
      </div>
    </div>

  </body>
</html>
