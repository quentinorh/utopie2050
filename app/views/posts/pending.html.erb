<% content_for :title, "SP2050 - Futur en attente" %>
<% content_for :description, "Ton futur est enregistré. Valide ton email pour le publier ou l'enregistrer en brouillon." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :hide_navbar, true %>

<% draft = PendingPostSession.draft?(@pending_post) %>
<% mail_sent = params[:mail_sent].present? %>
<% unique_id = "pending-#{SecureRandom.hex(4)}" %>
<% pattern_settings = PendingPostSession.pattern_settings_json(@pending_post) %>
<% outcome = draft ? "enregistre ton brouillon" : "publie ton futur" %>
<% cover_username = @cover_username.presence || flash[:pending_author].to_s.presence %>
<% identity_email = @pending_auth_email.to_s %>

<div class="sp-auth sp-auth--pending is-revealing"
     data-controller="cover-editor editor-reveal pending-auth"
     data-cover-editor-unique-id-value="<%= unique_id %>"
     data-cover-editor-new-record-value="true"
     data-pending-auth-cover-username-value="<%= cover_username %>"
     <% if mail_sent %>
     data-pending-auth-sync-cover-value="true"
     data-pending-auth-cover-upload-url-value="<%= pending_cover_posts_path %>"
     <% end %>>

  <%= render "devise/cover_stage",
             unique_id: unique_id,
             title: @pending_post["title"],
             pattern_settings: pattern_settings,
             show_title: true %>

  <div class="sp-panel">
    <div class="sp-content">
      <% if mail_sent %>
        <div class="sp-head">
          <h1 class="sp-title editor-stagger">Vérifie ta boîte mail</h1>
          <p class="sp-subtitle editor-stagger">
            Un lien de validation t'a été envoyé. Clique dessus pour te connecter :
            ton futur sera alors <%= draft ? "enregistré en brouillon" : "publié" %>.
          </p>
        </div>

        <p class="sp-note editor-stagger">
          Sans validation de l'email, <%= draft ? "l'enregistrement" : "la publication" %> ne peut pas aboutir.
          Tu ne reçois rien ? Vérifie tes spams ou
          <%= link_to "renvoie un lien", pending_posts_path, class: "sp-terms__link", data: { underline_link: "" } %>.
        </p>
      <% elsif @needs_identity %>
        <div class="sp-head">
          <% if @show_username && @show_terms %>
            <h1 class="sp-title editor-stagger"><%= draft ? "Pour enregistrer ton brouillon" : "Pour publier ton futur" %></h1>
            <p class="sp-subtitle editor-stagger">
              Le nom sur la couverture, puis ton accord pour créer le compte.
              Le lien partira à <%= identity_email %>.
            </p>
          <% elsif @show_username %>
            <h1 class="sp-title editor-stagger">Ton nom d'auteur·ice</h1>
            <p class="sp-subtitle editor-stagger">
              Il sera inscrit sur la couverture. Le lien partira à <%= identity_email %>.
            </p>
          <% else %>
            <h1 class="sp-title editor-stagger">Conditions d'utilisation</h1>
            <p class="sp-subtitle editor-stagger">
              Pour créer ton compte, accepte la charte. Le lien partira à <%= identity_email %>.
            </p>
          <% end %>
        </div>

        <%= form_with url: pending_auth_posts_path, method: :post, class: "sp-form sp-form--fields",
                      data: { pending_auth_target: "form", action: "submit->pending-auth#prepareSubmit", turbo: false } do %>
          <%= render "posts/pending_honeypot" %>
          <input type="hidden" name="email" value="<%= identity_email %>">
          <input type="hidden" name="age" value="<%= @pending_auth_age %>" data-pending-auth-target="age">
          <input type="file" name="cover_image" accept="image/jpeg,image/png" tabindex="-1" aria-hidden="true" class="hidden" data-pending-auth-target="coverImage">

          <% if @show_username %>
            <div class="sp-field editor-stagger">
              <label class="sp-label" for="pending_username">En 2050, comment aimerais-tu être appelé·e ?</label>
              <input type="text"
                     name="username"
                     id="pending_username"
                     class="sp-input"
                     placeholder="Je m'appelle …"
                     autocomplete="off"
                     required
                     autofocus
                     value="<%= @identity_username %>"
                     data-pending-auth-target="username usernameField"
                     data-action="input->pending-auth#onUsernameInput">
              <p class="sp-error" data-pending-auth-target="usernameError"></p>
            </div>
          <% else %>
            <input type="hidden" name="username" value="<%= @identity_username %>" data-pending-auth-target="username">
          <% end %>

          <% if @show_terms %>
            <div class="pending-terms editor-stagger">
              <%= render "posts/publication_terms" %>
              <label class="sp-remember" for="pending_terms">
                <input type="checkbox"
                       name="terms_accepted"
                       id="pending_terms"
                       value="1"
                       class="sp-checkbox"
                       required
                       data-pending-auth-target="terms"
                       data-action="change->pending-auth#onTermsChange">
                <span class="sp-remember-label">J'accepte les conditions d'utilisation</span>
              </label>
              <p class="sp-error" data-pending-auth-target="termsError"></p>
            </div>
          <% else %>
            <input type="hidden" name="terms_accepted" value="1">
          <% end %>

          <div class="sp-cta editor-stagger">
            <%= render "devise/sessions/submit", label: "Recevoir mon lien" %>
          </div>
        <% end %>
      <% else %>
        <div class="sp-head">
          <h1 class="sp-title editor-stagger"><%= draft ? "Enregistre ton brouillon" : "Publie ton futur" %></h1>
          <p class="sp-subtitle editor-stagger">
            Entre ton email pour <%= draft ? "l'enregistrer" : "le publier" %>.
            Tu recevras un lien de validation — indispensable pour finaliser.
          </p>
        </div>

        <%= form_with url: pending_auth_posts_path, method: :post, class: "sp-form",
                      data: { pending_auth_target: "form", action: "submit->pending-auth#prepareSubmit", turbo: false } do %>
          <%= render "posts/pending_honeypot" %>

          <input type="hidden" name="username" value="<%= @identity_username %>" data-pending-auth-target="username">
          <input type="hidden" name="age" value="<%= @pending_auth_age %>" data-pending-auth-target="age">
          <input type="hidden" name="terms_accepted" value="<%= @terms_already_accepted ? "1" : "" %>" data-pending-auth-target="termsAccepted">

          <div class="sp-field editor-stagger">
            <label class="sp-label" for="pending_email">Ton adresse email</label>
            <input type="email"
                   name="email"
                   id="pending_email"
                   class="sp-input"
                   placeholder="hello@fromfuture.com"
                   required
                   autofocus
                   value="<%= identity_email %>"
                   autocomplete="email">
          </div>

          <p class="sp-note editor-stagger">
            Nouveau ou déjà inscrit·e : même démarche. Le lien te connecte et <%= outcome %>.
          </p>

          <div class="sp-cta editor-stagger">
            <%= render "devise/sessions/submit", label: "Recevoir mon lien" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="sp-alt-wrap">
      <%= link_to "Modifier mon texte", new_post_path, class: "sp-alt editor-stagger", data: { underline_link: "" } %>
    </div>
  </div>
</div>
