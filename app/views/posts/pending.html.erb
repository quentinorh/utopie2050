<% content_for :title, "SP2050 - Futur en attente" %>
<% content_for :description, "Ton futur est enregistré. Valide ton email pour le publier ou l'enregistrer en brouillon." %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :hide_navbar, true %>

<% draft = PendingPostSession.draft?(@pending_post) %>
<% mail_sent = params[:mail_sent].present? %>
<% unique_id = "pending-#{SecureRandom.hex(4)}" %>
<% pattern_settings = PendingPostSession.pattern_settings_json(@pending_post) %>
<% outcome = draft ? "enregistre ton brouillon" : "publie ton futur" %>

<div class="sp-auth sp-auth--pending"
     data-controller="cover-editor editor-reveal pending-auth"
     data-cover-editor-unique-id-value="<%= unique_id %>"
     data-cover-editor-new-record-value="true">

  <%= render "devise/cover_stage",
             unique_id: unique_id,
             title: @pending_post["title"],
             pattern_settings: pattern_settings,
             show_title: true %>

  <div class="sp-panel">
    <div class="sp-content">
      <% if mail_sent %>
        <div class="sp-head">
          <h1 class="sp-title editor-stagger">Vérifie ta boîte mail</h1>
          <p class="sp-subtitle editor-stagger">
            Un lien de validation t'a été envoyé. Clique dessus pour te connecter :
            ton futur sera alors <%= draft ? "enregistré en brouillon" : "publié" %>.
          </p>
        </div>

        <p class="sp-note editor-stagger">
          Sans validation de l'email, <%= draft ? "l'enregistrement" : "la publication" %> ne peut pas aboutir.
          Tu ne reçois rien ? Vérifie tes spams ou
          <%= link_to "renvoie un lien", pending_posts_path, class: "sp-terms__link", data: { underline_link: "" } %>.
        </p>
      <% else %>
        <div class="sp-head">
          <h1 class="sp-title editor-stagger"><%= draft ? "Enregistre ton brouillon" : "Publie ton futur" %></h1>
          <p class="sp-subtitle editor-stagger">
            Entre ton email pour <%= draft ? "l'enregistrer" : "le publier" %>.
            Tu recevras un lien de validation — indispensable pour finaliser.
          </p>
        </div>

        <%= form_with url: pending_auth_posts_path, method: :post, class: "sp-form", data: { turbo: false } do %>
          <div aria-hidden="true" style="position: absolute; left: -9999px; top: -9999px; height: 0; width: 0; overflow: hidden;">
            <label for="website_url">Ne pas remplir</label>
            <input type="text" name="website_url" id="website_url" tabindex="-1" autocomplete="off" />
          </div>

          <input type="hidden" name="username" value="" data-pending-auth-target="username">
          <input type="hidden" name="age" value="" data-pending-auth-target="age">

          <div class="sp-field editor-stagger">
            <label class="sp-label" for="pending_email">Ton adresse email</label>
            <input type="email"
                   name="email"
                   id="pending_email"
                   class="sp-input"
                   placeholder="hello@fromfuture.com"
                   required
                   autofocus
                   value="<%= @pending_auth_email %>"
                   autocomplete="email">
          </div>

          <p class="sp-note editor-stagger">
            Nouveau ou déjà inscrit·e : même démarche. Le lien te connecte et <%= outcome %>.
          </p>

          <div class="sp-cta editor-stagger">
            <%= render "devise/sessions/submit", label: "Recevoir mon lien" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="sp-alt-wrap">
      <%= link_to "Modifier mon texte", new_post_path, class: "sp-alt editor-stagger", data: { underline_link: "" } %>
    </div>
  </div>
</div>
