<div class="group relative">
  <div class="relative aspect-[3/4]">
    <div class="absolute inset-0 overflow-hidden rounded-xl bg-gray-950/[0.03] dark:bg-white/[0.03] ring-1 ring-gray-950/5 dark:ring-white/5">
      <%= link_to post_path(post), class: "absolute inset-0 z-0 flex", aria: { label: post.title } do %>
        <% if post.cover.present? %>
          <div class="size-full [&>svg]:size-full"><%= post.cover.html_safe %></div>
        <% end %>
      <% end %>
    </div>

    <% if post.draft %>
      <span class="pointer-events-none absolute top-2 left-2 z-10 rounded-md bg-gray-900/70 px-1.5 py-0.5 font-mono text-[0.625rem] uppercase tracking-wide text-white/80">brouillon</span>
    <% end %>
    <% if post.reports.any? %>
      <span class="pointer-events-none absolute top-2 right-2 z-10 flex size-5 items-center justify-center rounded-full bg-red-500 text-[0.625rem] font-medium text-white tabular-nums"><%= post.reports.count %></span>
    <% end %>

    <div class="absolute right-1.5 bottom-1.5 z-10 flex items-center gap-1 opacity-100 transition-opacity lg:opacity-0 lg:group-hover:opacity-100">
      <%= link_to edit_post_path(post),
          class: "flex size-7 items-center justify-center rounded-lg bg-white/90 dark:bg-gray-900/90 ring-1 ring-gray-950/10 dark:ring-white/10 text-gray-500 hover:text-gray-900 dark:hover:text-white",
          aria_label: "Éditer",
          title: "Éditer" do %>
        <svg viewBox="0 0 16 16" fill="none" class="size-3.5 stroke-current shrink-0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2.5l2.5 2.5L5 13.5H2.5V11z"/></svg>
      <% end %>

      <%= link_to post_path(post),
          data: { turbo_method: :delete, turbo_confirm: "Supprimer ce futur ?" },
          class: "flex size-7 items-center justify-center rounded-lg bg-white/90 dark:bg-gray-900/90 ring-1 ring-gray-950/10 dark:ring-white/10 text-gray-400 hover:text-red-600",
          aria_label: "Supprimer",
          title: "Supprimer" do %>
        <svg viewBox="0 0 16 16" fill="none" class="size-3.5 stroke-current shrink-0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h10M6 4V2.5h4V4M4.5 4v9a1 1 0 001 1h5a1 1 0 001-1V4"/></svg>
      <% end %>

      <div class="relative" data-controller="dropdown reel-export carousel-export" data-reel-export-post-id-value="<%= post.id %>" data-carousel-export-post-id-value="<%= post.id %>">
        <button type="button" data-action="click->dropdown#toggle"
                class="flex size-7 items-center justify-center rounded-lg bg-white/90 dark:bg-gray-900/90 ring-1 ring-gray-950/10 dark:ring-white/10 text-gray-500 hover:text-gray-900 dark:hover:text-white"
                aria-label="Exporter"
                title="Exporter">
          <svg viewBox="0 0 16 16" fill="none" class="size-3.5 stroke-current shrink-0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8v5.5a1 1 0 001 1h10a1 1 0 001-1V8"/><polyline points="5 4 8 1 11 4"/><line x1="8" y1="1" x2="8" y2="10"/></svg>
        </button>
        <div data-dropdown-target="menu"
             class="hidden absolute right-0 bottom-full z-30 mb-1 w-44 origin-bottom-right rounded-xl bg-white dark:bg-gray-900 ring-1 ring-gray-950/10 dark:ring-white/10 p-1 shadow-lg shadow-gray-950/5 dark:shadow-none opacity-0 scale-95 transition duration-100 ease-out data-[open]:opacity-100 data-[open]:scale-100">
          <button type="button" data-action="click->reel-export#exportReel" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-950/5 dark:hover:bg-white/5">
            Instagram Reel
          </button>
          <button type="button" data-action="click->carousel-export#exportCarousel" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-950/5 dark:hover:bg-white/5">
            Carrousel Instagram (4:5)
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-2.5">
    <p class="text-sm font-medium text-gray-900 dark:text-gray-100 truncate">
      <%= link_to post.title, post_path(post), class: "hover:text-gray-600 dark:hover:text-gray-300" %>
    </p>
    <p class="text-sm text-gray-400 dark:text-gray-500">
      <span><%= post.user.username %></span>
      <span class="mx-1 text-gray-300 dark:text-gray-700">&middot;</span>
      <span class="tabular-nums"><%= post.created_at.strftime("%d.%m.%Y") %></span>
    </p>
  </div>
</div>
