<% if notice || alert %>
  <div class="flash-container" data-controller="flash">
    <% if notice %>
      <div class="flash flash--notice" role="alert" data-flash-target="alert">
        <span class="flash__indicator" aria-hidden="true"></span>
        <p class="flash__message"><%= notice %></p>
        <button type="button"
                class="flash__close"
                data-action="flash#close"
                aria-label="Fermer la notification">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    <% end %>
    <% if alert %>
      <div class="flash flash--alert" role="alert" data-flash-target="alert">
        <span class="flash__indicator" aria-hidden="true"></span>
        <p class="flash__message"><%= alert %></p>
        <button type="button"
                class="flash__close"
                data-action="flash#close"
                aria-label="Fermer la notification">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
