<div class="editor-creativity-booster editor-stagger"
     data-controller="creativity-booster">
  <script type="application/json" id="creativity-booster-questions-json"><%= raw CreativityBoosterQuestions::QUESTIONS.to_json %></script>

  <button type="button"
          class="cover-pill cover-pill--sm"
          data-action="click->creativity-booster#boost"
          data-creativity-booster-target="trigger"
          aria-expanded="false"
          aria-controls="creativity-booster-prompt">
    <span class="cover-pill__label">Booster de créativité</span>
  </button>

  <figure id="creativity-booster-prompt"
          class="editor-creativity-booster__prompt hidden"
          data-creativity-booster-target="prompt"
          hidden
          aria-live="polite">
    <div class="editor-creativity-booster__prompt-head">
      <blockquote class="editor-creativity-booster__question"
      data-creativity-booster-target="question"></blockquote>
      <button type="button"
              class="editor-creativity-booster__close"
              data-action="click->creativity-booster#close"
              aria-label="Fermer la question">
        <svg xmlns="http://www.w3.org/2000/svg"
             viewBox="0 0 16 16"
             fill="none"
             stroke="currentColor"
             stroke-width="1.5"
             stroke-linecap="round"
             aria-hidden="true">
          <line x1="4" y1="4" x2="12" y2="12"/>
          <line x1="12" y1="4" x2="4" y2="12"/>
        </svg>
      </button>
    </div>

  </figure>
</div>
